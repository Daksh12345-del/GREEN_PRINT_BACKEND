# Copy this file to .env and fill in real values.

# Your Supabase Postgres connection string — use the POOLER connection
# (Project Settings → Database → Connection Pooling → URI, port 5432 /
# Session mode), NOT the direct "Connection string" one. The direct one
# requires IPv6 and commonly fails with ENOTFOUND on normal networks.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres

# Used to sign JWTs. Change this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Your deployed Vercel frontend's URL, e.g. https://greenprint.vercel.app
# Restricts which origin can call this API. Leave unset (defaults to "*",
# any origin) for local development.
ALLOWED_ORIGIN=

# Optional: enables the real AI Recommendation Engine (calls Groq's free,
# OpenAI-compatible chat API). Get a free key at https://console.groq.com/keys
# — no credit card required for the free tier at time of writing.
# If omitted, Green Print falls back to transparent rule-based
# recommendations — the app still works fully without this key.
GROQ_API_KEY=

# Optional: override the default Groq model (openai/gpt-oss-120b).
GROQ_MODEL=
